# =====================================================================
# EasiAcc Events — variables de entorno del backend (EJEMPLO, sin secretos)
# Copia a .env (local) o configúralas en tu plataforma (producción).
# NUNCA subas .env a Git. Genera secretos con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# =====================================================================

# Identidad de la plataforma (opcional; valores por defecto en app/branding.py)
# BRAND_NAME=EasiAcc
# PRODUCT_NAME=EasiAcc Events
# BRAND_TAGLINE=Simplifica tu negocio.
# PUBLIC_WEBSITE_URL=https://easiacc.com

# Entorno: development | test | production
FLASK_ENV=development

# ---- Base de datos (MySQL 8) ----
# development exige la base crm_events_dev; test exige crm_events_test.
DB_URL_DEV=mysql+pymysql://usuario:clave@127.0.0.1:3306/crm_events_dev
DB_URL_TEST=mysql+pymysql://usuario:clave@127.0.0.1:3306/crm_events_test
DB_URL_PROD=mysql+pymysql://usuario:clave@host-mysql:3306/eventos_saas_prod?ssl_verify_cert=true
CHECK_DB_ON_STARTUP=true
# Producción: TLS verificado contra el CA del proveedor de MySQL administrado
# DB_SSL_CA=/ruta/al/ca.pem
# DB_SSL_VERIFY_HOSTNAME=true

# ---- Secretos (mínimo 32 caracteres aleatorios en producción) ----
# SECRET_KEY firma los tokens de sesión: si se filtra, se pueden falsificar sesiones.
SECRET_KEY=
JWT_SECRET_KEY=
SIGNATURE_OTP_SECRET=

# ---- Archivos (documentos y firmas de contratos) ----
UPLOAD_FOLDER_LOCAL=uploads/local
UPLOAD_FOLDER_TEST=uploads/test
UPLOAD_FOLDER_PROD=/data/uploads
# Opcional: rutas separadas para documentos y firmas
# CONTRACT_DOCUMENT_STORAGE_ROOT=/data/uploads/contract_documents
# CONTRACT_SIGNATURE_STORAGE_ROOT=/data/uploads/contract_signatures
MAX_CONTENT_LENGTH=20971520

# ---- Frontend / CORS ----
FRONTEND_PUBLIC_URL=http://localhost:4200
# Producción: solo https, separados por coma
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ---- Correo (OTP de firma, comprobantes) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=EasiAcc Events

# ---- Mercado Pago (suscripciones) ----
# Usa credenciales de PRUEBA (TEST-...) fuera de producción y de PRODUCCIÓN (APP_USR-...) solo en producción.
MP_ACCESS_TOKEN=
# "Clave secreta" del webhook (Tus integraciones > Webhooks)
MP_WEBHOOK_SECRET=
# URL https a la que Mercado Pago regresa al usuario (pantalla de retorno del frontend)
MP_BACK_URL=https://app.easiacc.com/billing/return
# Minutos tras los que un checkout no autorizado deja de bloquear un nuevo intento
MP_CHECKOUT_PENDING_TTL_MINUTES=30

# ---- Sesión, recuperación de contraseña e invitaciones ----
# Duración máxima de una sesión aunque se renueve (segundos). Por defecto 12 h.
SESSION_MAX_AGE=43200
# Días de vigencia de una invitación a la empresa.
INVITATION_TTL_DAYS=7

# ---- Facturación de la plataforma ----
# IDs de usuario (tabla users) que operan el panel global. Separados por coma.
BILLING_OPERATOR_USER_IDS=
# true = aplica límites por plan (clientes, eventos, reportes). Activar solo con la política comercial definida.
BILLING_ENFORCE_ENTITLEMENTS=false

# ---- Rate limiting ----
# Producción: almacenamiento compartido entre workers (p. ej. redis://host:6379/0)
RATELIMIT_STORAGE_URI=memory://
# RATELIMIT_ALLOW_MEMORY=true   # solo si corre UN único proceso; no recomendado

# ---- Gunicorn (producción) ----
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
# Número de proxies inversos delante del backend (nginx del frontend = 1).
# Necesario para que rate limiting y auditoría usen la IP real del cliente.
TRUSTED_PROXY_COUNT=0
# IP del proxy TLS de confianza (nginx / balanceador)
FORWARDED_ALLOW_IPS=127.0.0.1
