# Copiar a env/backend.env en el servidor (permisos 600). No versionar.
# Generar secretos: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DB_URL_PROD=mysql+pymysql://eventos_app:CLAVE@HOST-PRIVADO-DE-LA-BASE:PUERTO/eventos_saas_prod
# TLS obligatorio en producción: CA del proveedor guardado en deploy/env/certs/db-ca.pem
# (Linode: botón "Download CA Certificate" en el detalle de la base de datos).
DB_SSL_CA=/etc/eventos/certs/db-ca.pem
# Solo si el certificado no incluye el nombre del host (se sigue verificando el CA):
# DB_SSL_VERIFY_HOSTNAME=false
SECRET_KEY=
JWT_SECRET_KEY=
SIGNATURE_OTP_SECRET=
CORS_ORIGINS=https://app.easiacc.com
FRONTEND_PUBLIC_URL=https://app.easiacc.com
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_BACK_URL=https://app.easiacc.com/billing/return
BILLING_OPERATOR_USER_IDS=
BILLING_ENFORCE_ENTITLEMENTS=false
# Correo transaccional (docs/PUESTA_EN_MARCHA.md §2). Brevo: smtp-relay.brevo.com · Resend: smtp.resend.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@easiacc.com
SMTP_FROM_NAME=EasiAcc Events
GUNICORN_WORKERS=3
