# Copiar a env/backend.env en el servidor (permisos 600). No versionar.
# Generar secretos: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DB_URL_PROD=mysql+pymysql://eventos_app:CLAVE@host-mysql-administrado:3306/eventos_saas_prod?ssl_ca=/etc/ssl/certs/ca-certificates.crt
SECRET_KEY=
JWT_SECRET_KEY=
SIGNATURE_OTP_SECRET=
CORS_ORIGINS=https://app.tu-dominio.com
FRONTEND_PUBLIC_URL=https://app.tu-dominio.com
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_BACK_URL=https://app.tu-dominio.com/billing/return
BILLING_OPERATOR_USER_IDS=
BILLING_ENFORCE_ENTITLEMENTS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Eventos SaaS
GUNICORN_WORKERS=3
