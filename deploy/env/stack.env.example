# Copiar a env/stack.env en el servidor (permisos 600). No versionar.
STACK_NAME=eventos
# Uno o varios hosts separados por coma (todos apuntan al mismo servidor):
DOMAIN=app.easiacc.com, easiacc.com, www.easiacc.com
ACME_EMAIL=admin@easiacc.com
# Imágenes publicadas por GitHub Actions al crear un tag vX.Y.Z
BACKEND_IMAGE=ghcr.io/jesuspayan/events-saas-backend
FRONTEND_IMAGE=ghcr.io/jesuspayan/event-saas-frontend
RELEASE_TAG=v1.1.0
BACKEND_ENV_FILE=env/backend.env

# ---- Backups (usuario MySQL de solo lectura + LOCK TABLES/SHOW VIEW/TRIGGER/EVENT) ----
DB_HOST=host-mysql-administrado
DB_PORT=3306
DB_NAME=eventos_saas_prod
DB_BACKUP_USER=eventos_backup
DB_BACKUP_PASSWORD=
BACKUP_DIR=/var/backups/eventos
BACKUP_RETENTION_DAYS=14
# Opcional: destino externo configurado con `rclone config` (p. ej. linode:eventos-backups/prod; en staging, /staging)
RCLONE_REMOTE=
