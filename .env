DB_URL_PROD=mysql+pymysql://root:root@localhost:3306/crm_events_prod
DB_URL_TEST=mysql+pymysql://root:root@localhost:3306/crm_events_test
# =============================================
# STORAGE
# =============================================
UPLOAD_FOLDER_LOCAL=uploads/development
